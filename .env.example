# Environment Variables for LOOP

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or any hosted Postgres)
# Enable pgvector extension first: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Random secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here-minimum-32-chars"

# Base URL of your application
AUTH_URL="http://localhost:3000"

# Set to true for Vercel / proxied deployments
AUTH_TRUST_HOST="true"

# ─── AI (Groq) ────────────────────────────────────────────────────────────────
# Groq API key — get from https://console.groq.com
# Never commit this key — keep it server-side only
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Groq model to use (optional, defaults to openai/gpt-oss-120b)
GROQ_MODEL_NAME="openai/gpt-oss-120b"
